# --- Secrets, Credentials & Environment Files ---
.env
.env.*
*.env
**/.env
**/.env.*
!**/.env.example
!*.env.example
!.env.example
token.json
**/token.json
credentials.json
**/credentials.json
client_secret*.json
**/client_secret*.json
*.pem
*.key
*.p12

# --- Python Bytecode & Packaging ---
__pycache__/
**/__pycache__/
*.py[cod]
*.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Virtual Environments ---
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
myenv/
**/myenv/

# --- Browser & Automation Cache (Selenium / ChromeDriver) ---
LinkScraperAutomate/
**/LinkScraperAutomate/
facebook_profile/
**/facebook_profile/
chrome_crawler_*
**/chrome_crawler_*
cache/
**/cache/
Singleton*
**/Singleton*
*.log
**/logs/
debug_*.png
error.png
example.png

# --- Scraped Data Output Files (Keep repo lightweight) ---
*.csv
**/*.csv
*.tsv
*.parquet
*.sqlite
*.sqlite3
*.db

# --- Compressed Archives ---
*.zip
*.tar.gz
*.tgz
*.rar
*.7z

# --- Jupyter Notebooks & Data Science ---
*.ipynb
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# --- Operating System & Editor Artifacts ---
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.sublime-workspace
*.sublime-project

