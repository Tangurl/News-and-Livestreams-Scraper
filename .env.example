# ==============================================================================
# Google Apps Script Web App Deployment URL
# (Used by ViewStatsScraper, ProgramScheduleFetcher)
# ==============================================================================
STREAM_STATS_API="https://script.google.com/macros/s/YOUR_WEB_APP_ID/exec" #ผังรายการรวม

# ==============================================================================
# Google Sheets Configuration for NewsScraper (run_all.py)
# ==============================================================================
# ID of the Google Sheet to sync scraped news articles to (string between /d/ and /edit)
NEWS_SHEET_ID="" #ข่าว

# ==============================================================================
# Target Channel Base URLs (For linkcrawler.py)
# ==============================================================================
PAGE_URL_FB="https://www.facebook.com/ThaiPBS/live_videos/"
PAGE_URL_YT="https://www.youtube.com/@ThaiPBS/streams"
PAGE_URL_X="https://x.com/ThaiPBS"
PAGE_URL_TT="https://www.tiktok.com/@thaipbs/live"

# ==============================================================================
# Link Crawler Timing Settings
# ==============================================================================
CHECK_INTERVAL_SECONDS=30
DELAY_MINUTES=4
PAGE_WAIT_SECONDS_FB=8
PAGE_WAIT_SECONDS_YT=5
PAGE_WAIT_SECONDS_X=5

# Only crawl the currently active broadcast on air (skip older ended shows from earlier today)
CURRENT_ONLY=true

# Concurrent channels queue limit (e.g. 5 channels at once)
CRAWLER_CONCURRENCY=5

# Search attempts per platform (1 = search once without refetching/retrying to save time)
MAX_ATTEMPTS=1

# ==============================================================================
# View Stats Scraper Settings
# ==============================================================================
# Run view stats scraper continuously in a loop (true/false)
VIEW_STATS_LOOP=false

# Interval in seconds between view stats snapshot runs (default: 300 = 5 minutes)
VIEW_STATS_INTERVAL=300

# ==============================================================================
# Facebook Auto Re-Login Settings (Optional)
# ==============================================================================
# Automatically re-authenticate (fill FB_EMAIL / FB_PASSWORD into the login form)
# if the Facebook logged-in Chrome profile gets logged out while crawling
FB_AUTO_LOGIN=false
FB_EMAIL=""
FB_PASSWORD=""
FB_LOGIN_COOLDOWN_MINUTES=30
FB_AUTO_LOGIN_HEADLESS=true

# ==============================================================================
# ProgramScheduleFetcher Settings
# ==============================================================================
DTT_URL=https://dttguide.nbtc.go.th/BcsEpgDataServices/BcsEpgDataController/getProgramDataWeb
TZ=Asia/Bangkok
REQUEST_TIMEOUT=60
APPS_SCRIPT_TIMEOUT=300
MAX_RETRIES=5
RETRY_WAIT=5
